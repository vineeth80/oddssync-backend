# OddsSync Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Data refresh intervals (seconds)
PRICE_REFRESH_INTERVAL=60
FULL_REFRESH_INTERVAL=300
DEPTH_REFRESH_INTERVAL=3600

# Kalshi (no auth needed for public data)
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Polymarket
POLY_GAMMA_URL=https://gamma-api.polymarket.com
POLY_CLOB_URL=https://clob.polymarket.com

# Rate limiting
RATE_LIMIT=60/minute
